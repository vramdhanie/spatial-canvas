{
  "name": "spatial-canvas",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "infra:up": "docker compose --env-file .env -f infra/local/docker-compose.yml up -d --wait",
    "infra:down": "docker compose --env-file .env -f infra/local/docker-compose.yml down",
    "infra:logs": "docker compose --env-file .env -f infra/local/docker-compose.yml logs -f",
    "seed": "node --env-file-if-exists=.env infra/local/seed-users.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "turbo": "^2.11.11",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
