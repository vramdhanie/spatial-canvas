# Copy to .env (git-ignored). All values below are LOCAL TEST values only.

# --- Ports (all traffic reaches the browser through the web dev server's single origin) ---
WEB_PORT=5173
API_PORT=4100
SYNC_PORT=4101
AGENTS_PORT=4102

# --- MongoDB (mongodb-atlas-local in Docker) ---
MONGODB_URI=mongodb://localhost:27017/spatial_canvas?directConnection=true

# --- Redis (Yjs backplane; only needed when running 2 sync nodes) ---
REDIS_URL=redis://localhost:6379

# --- Object storage (fake-gcs-server in Docker; GCS-compatible) ---
STORAGE_EMULATOR_HOST=http://localhost:4443
STORAGE_BUCKET=spatial-canvas

# --- Auth (Firebase Auth emulator, demo project: no GCP account needed) ---
FIREBASE_PROJECT_ID=demo-spatial-canvas
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
VITE_FIREBASE_PROJECT_ID=demo-spatial-canvas
VITE_FIREBASE_API_KEY=demo-api-key

# --- AI ---
ANTHROPIC_API_KEY=

# --- Remote access (optional) — your static ngrok domain, e.g. something.ngrok-free.app ---
NGROK_DOMAIN=
